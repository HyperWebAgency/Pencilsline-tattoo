# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Supabase project: Pencilsline-Tattoo (ref rizweifbhhosnylnxmio, eu-west-1)

# --- Safe to expose to the browser ---
NEXT_PUBLIC_SUPABASE_URL=https://rizweifbhhosnylnxmio.supabase.co
# Dashboard > Project Settings > API Keys. Publishable key (sb_publishable_...),
# or the legacy "anon" JWT if this project still shows the old key pair.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- SERVER ONLY. Bypasses Row Level Security entirely. ---
# No NEXT_PUBLIC_ prefix, ever. Only read inside route handlers / server code.
# Secret key (sb_secret_...), or the legacy "service_role" JWT.
SUPABASE_SECRET_KEY=

# --- Optional: only needed if running psql / supabase CLI migrations locally ---
# Dashboard > Connect > Direct connection. Use the session pooler URI if IPv6 fails.
SUPABASE_DB_URL=

# --- Contact page: Formspree ---
# Create a form at https://formspree.io and paste its endpoint here.
# Public by design — it is called from the browser.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Site origin (optional) ---
# Only needed to override what the deployment reports. On Vercel this is
# derived automatically, and switches to the custom domain the moment one is
# attached. Set it if the site is hosted anywhere else.
# NEXT_PUBLIC_SITE_URL=https://pencilsline-tattoo.vercel.app
